{
  "beast_jar": "../BEAST/build/dist/beast.jar",
  "java_args": [
    "-Xmx2g",
    "-XX:+UseSerialGC",
    "-Djava.library.path=/opt/homebrew/lib"
  ],
  "beast_args": [
    "-citations_off",
    "-tests",
    "0",
    "-overwrite",
    "-beagle_CPU",
    "-beagle_threads",
    "1",
    "-threads",
    "1"
  ],
  "workers": 12,
  "samples": 2000,
  "burnin": 0.1,
  "pilot_runs": 3,
  "pilot_states": 20000000,
  "reference_runs": 4,
  "reference_multiplier": 10,
